# jwt auth
SMART_FRIDGE_AUTH_JWT_SECRET=

# Oauth Yandex ID
SMART_FRIDGE_OAUTH_YANDEX_CLIENT_ID=
SMART_FRIDGE_OAUTH_YANDEX_CLIENT_SECRET=

# PostgreSQL
POSTGRES_USER=smart_fridge
POSTGRES_PASSWORD=
POSTGRES_DB=smart_fridge
POSTGRES_PORT=5433

# Database URL
SMART_FRIDGE_DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable"

SMART_FRIDGE_STORAGE_ENDPOINT=https://storage.yandexcloud.net
SMART_FRIDGE_STORAGE_REGION=ru-central1
SMART_FRIDGE_STORAGE_BUCKET=
SMART_FRIDGE_STORAGE_ACCESS_KEY_ID=
SMART_FRIDGE_STORAGE_SECRET_ACCESS_KEY=
